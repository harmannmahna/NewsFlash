MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=NEWSFLASH
JWT_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
PORT=5000
